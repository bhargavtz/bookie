# Copy to .env.local and fill in. Placeholders only; never commit real values.
# Every variable is validated by src/lib/env.ts at startup (fails fast, never prints values).

NODE_ENV=development
SITE_URL=http://localhost:3000

# Public contact address shown on /contact, /copyright and /licensing. Leave empty until the owner has a monitored mailbox; the pages then say no address is configured.
CONTACT_EMAIL=

# Database. Leave DATABASE_URL empty to use embedded PGlite (dev/test only).
# Production: PostgreSQL >= 16 (17+ recommended), e.g. postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
DATABASE_POOL_MAX=10
PGLITE_DATA_DIR=.data/pglite

# Storage: "local" (default) or "s3" (AWS S3, Cloudflare R2, MinIO, ...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# "proxy" streams downloads through the app (default); "redirect" issues a <=60 s presigned URL (s3 only)
DOWNLOAD_MODE=proxy
MAX_UPLOAD_BYTES=209715200

# Admin bootstrap credential (format scrypt$N$r$p$salt$hash). No default; admin is disabled if unset.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Random string (>= 16 chars) used to salt IP hashes. Required in production.
IP_HASH_SALT=
TRUST_PROXY=false
READER_SYNC=false
