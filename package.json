{
  "name": "bookie-nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "next dev --turbopack",
    "dev:log": "mkdir -p .logs && next dev --turbopack 2>&1 | tee .logs/dev.log",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node scripts/clean-next-types.mjs && next typegen && tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:unit": "vitest run --configLoader runner --project unit",
    "test:integration": "vitest run --configLoader runner --project integration",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "e2e": "playwright test",
    "check:env": "node scripts/check-env.mjs",
    "verify": "node scripts/check-env.mjs && npm run lint && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:setup": "npm run db:migrate && npm run db:bootstrap",
    "admin:hash": "tsx scripts/admin-hash.ts",
    "gen:pdfs": "tsx scripts/gen-test-pdfs.ts",
    "pretest": "tsx scripts/gen-test-pdfs.ts",
    "assets:pdfjs": "node scripts/copy-pdfjs-assets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1166.0",
    "@aws-sdk/s3-request-presigner": "3.1166.0",
    "drizzle-orm": "0.45.4",
    "gsap": "^3.13.0",
    "next": "15.5.29",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.16",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
